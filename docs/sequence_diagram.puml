@startuml Phase3_SequenceDiagram

title SDA Project Phase 3 - Generic Concurrent Real-Time Pipeline\nSequence Diagram

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantFontStyle bold
skinparam sequenceParticipantFontSize 12
skinparam sequenceLifeLineBorderColor #555555
skinparam sequenceBoxBackgroundColor #F0F4FF
skinparam sequenceBoxBorderColor #2E75B6
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7
skinparam ArrowColor #333333

' ── Participants ──────────────────────────────────────────────────────────────
participant "main.py\n(bootstrap)" as MAIN #D6E4FF
participant "StreamingCSVReader\n[Process: Input]" as INPUT #D6FFD6
participant "raw_queue\n<<Queue, maxsize=50>>" as RQ #EEEEEE
participant "CoreWorker-0..N\n[Processes: Scatter ×N]" as CORE #FFE5CC
participant "processed_queue\n<<Queue, maxsize=50>>" as PQ #EEEEEE
participant "Aggregator\n[Process: Gather]" as AGG #E5CCFF
participant "output_queue\n<<Queue, maxsize=50>>" as OQ #EEEEEE
participant "PipelineTelemetry\n[Subject]" as TEL #FFFDE7
participant "RealtimeDashboard\n[Observer, main thread]" as DASH #FFD6D6

' ── 1. Bootstrap ─────────────────────────────────────────────────────────────
== 1. Bootstrap & Wiring (main thread) ==

MAIN -> MAIN : load_config("config.json")
MAIN -> RQ : create Queue(maxsize=50)
MAIN -> PQ : create Queue(maxsize=50)
MAIN -> OQ : create Queue(maxsize=50)
MAIN -> TEL : PipelineTelemetry(raw_q, proc_q, out_q, max_size=50)
MAIN -> DASH : RealtimeDashboard(output_queue, telemetry, config)
DASH -> TEL : subscribe(self)
note right of TEL
  Observer registered.
  Dashboard is now an observer
  of the telemetry subject.
end note

MAIN -> AGG : Process(target=run_aggregator).start()
MAIN -> CORE : Process(target=run_core_worker, ×N).start()
MAIN -> INPUT : Process(target=run_input).start()

note over MAIN
  Dashboard.run() called
  in the main thread
  (matplotlib requires main thread).
end note

' ── 2. Input Stage ────────────────────────────────────────────────────────────
== 2. Input Stage: StreamingCSVReader (runs concurrently) ==

loop for each row in CSV
  INPUT -> INPUT : _map_row(raw_row)\n→ generic packet\n{entity_name, time_period,\n metric_value, security_hash}

  alt raw_queue is full (backpressure)
    INPUT -> RQ : put(packet)  ⟵ BLOCKS until space opens
    note right of RQ
      Bounded queue (maxsize=50).
      When full, put() blocks —
      this is automatic backpressure.
      Input slows to match Core throughput.
    end note
  else raw_queue has space
    INPUT -> RQ : put(packet)
  end
  INPUT -> INPUT : time.sleep(input_delay_seconds)
end


INPUT -> RQ : put(SENTINEL=None)
note right of INPUT
  Poison pill signals
  "stream finished" to
  all CoreWorkers.
end note

' ── 3. Core Stage ─────────────────────────────────────────────────────────────
== 3. Core Stage: CoreWorker ×N (Scatter — runs concurrently) ==

loop until SENTINEL received
  CORE -> RQ : get()  ← blocks until packet arrives

  alt packet is SENTINEL (None)
    CORE -> RQ : put(SENTINEL)
    note right of CORE
      Re-queue sentinel so
      other workers also see it.
    end note
    CORE -> CORE : break (shutdown)
  else packet is data
    CORE -> CORE : verify_signature(\n  raw_value, signature,\n  secret_key, iterations=100000\n)\n[PBKDF2-HMAC-SHA256\n— Pure Function]

    alt signature VALID
      CORE -> CORE : packet["verified_by"] = worker_id
      CORE -> PQ : put(verified_packet)
    else signature INVALID
      CORE -> CORE : drop packet\n(print warning, continue)
      note right of CORE
        Unverified packets are
        silently discarded here.
        Never reach Aggregator.
      end note
    end
  end
end

' ── 4. Aggregator Stage ───────────────────────────────────────────────────────
== 4. Aggregator Stage: Gather (single process — stateful) ==

note over AGG
  Waits for N sentinel pills
  (one per CoreWorker) before shutting down.
end note

loop until N sentinels received
  AGG -> PQ : get()  ← blocks until packet arrives

  alt packet is SENTINEL
    AGG -> AGG : sentinels_seen += 1
  else packet is verified data
    AGG -> AGG : _window.append(metric_value)\nif len > window_size: pop(0)
    AGG -> AGG : avg = compute_running_average(_window)\n[Pure Function — Functional Core]
    AGG -> AGG : packet["computed_metric"] = round(avg, 4)
    AGG -> OQ : put(enriched_packet)
  end
end

AGG -> OQ : put(SENTINEL=None)
note right of AGG
  Signals dashboard
  that stream is complete.
end note
