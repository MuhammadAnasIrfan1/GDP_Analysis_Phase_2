@startuml Phase3_ClassDiagram

title SDA Project Phase 3 - Generic Concurrent Real-Time Pipeline\nClass Diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam classFontSize 13
skinparam packageFontSize 13
skinparam ArrowColor #333333
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #555555
skinparam packageBackgroundColor #F0F4FF
skinparam packageBorderColor #2E75B6
skinparam noteBorderColor #AAAAAA
skinparam noteBackgroundColor #FFFDE7

' ─────────────────────────────────────────────
package "core" {

  interface DataSink <<Protocol>> {
    +write(key: str, data: Any): None
  }



  interface PipelineService <<Protocol>> {
    +execute(raw_data: List[Any]): None
  }

  interface TelemetrySubject <<Protocol>> {
    +get_stats(): dict
  }
  
  class CoreWorker {
    -worker_id: int
    -raw_queue: Queue
    -processed_queue: Queue
    -secret_key: str
    -iterations: int
    -value_field: str
    -hash_field: str
    +SENTINEL: None
    +__init__(worker_id, raw_queue, processed_queue, config)
    +run(): None
  }

  class Aggregator {
    -processed_queue: Queue
    -output_queue: Queue
    -num_workers: int
    -window_size: int
    -value_field: str
    -_window: list
    +SENTINEL: None
    +__init__(processed_queue, output_queue, config, num_workers)
    +run(): None
    +{static} compute_running_average(window: list): float
  }

  note right of Aggregator
    Functional Core, Imperative Shell:
    compute_running_average() is the
    pure Functional Core (no side effects).
    run() is the Imperative Shell
    (manages state & queues).
  end note

  note right of CoreWorker
    Scatter pattern:
    N copies run in parallel,
    all pulling from the same raw_queue.
    verify_signature() is the
    pure Functional Core.
  end note
}


' ─────────────────────────────────────────────
package "core::functions" {
  class "verify_signature()" as VS <<function>> {
    +raw_value: float
    +signature: str
    +secret_key: str
    +iterations: int
    --
    returns bool
    (PBKDF2-HMAC-SHA256 — pure function)
  }
}
